{
  "name": "brotli-wasm-2",
  "version": "0.0.3",
  "description": "JavaScript bindings for Brotli compression compiled to WebAssembly",
  "keywords": [
    "brotli",
    "compress",
    "compression",
    "decompress",
    "decompression",
    "wasm"
  ],
  "homepage": "https://github.com/jeremy-code/brotli-wasm-2#readme",
  "bugs": "https://github.com/jeremy-code/brotli-wasm-2/issues",
  "license": "MIT",
  "author": "Jeremy Nguyen <hi@jeremy.ng> (https://jeremy.ng/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremy-code/brotli-wasm-2.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./imports": {
      "types": "./dist/imports.d.ts",
      "default": "./dist/imports.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces.d.ts",
      "default": "./dist/interfaces.js"
    },
    "./brotli.wasm": "./dist/brotli.wasm",
    "./loaders": {
      "bun": {
        "types": "./dist/loaders/browser.d.ts",
        "default": "./dist/loaders/browser.js"
      },
      "workerd": {
        "types": "./dist/loaders/node.d.ts",
        "default": "./dist/loaders/node.js"
      },
      "browser": {
        "types": "./dist/loaders/browser.d.ts",
        "default": "./dist/loaders/browser.js"
      },
      "node": {
        "types": "./dist/loaders/node.d.ts",
        "default": "./dist/loaders/node.js"
      },
      "default": {
        "types": "./dist/loaders/browser.d.ts",
        "default": "./dist/loaders/browser.js"
      }
    }
  },
  "scripts": {
    "prebuild": "mkdir -p dist && docker run --rm -v ./:/src $(docker build -q .) ./scripts/compile.sh",
    "build": "tsc --project ./tsconfig.build.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "ci:publish": "./scripts/publish.sh"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@vitest/browser-playwright": "^5.1.0",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
